{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "settings-*", "addpopup-*", "appsettings-*", "global-settings", "quitconfirm-*", "downloadspopup-*"],
  "webviews": ["sidebar-*", "toolbar-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-read-image"
  ]
}
